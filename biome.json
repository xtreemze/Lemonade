{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!build",
      "!dist",
      "!node_modules",
      "!playwright-report",
      "!test-results",
      "!coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "astro": "none",
      "drizzle": "none",
      "next": "none",
      "playwright": "all",
      "project": "all",
      "qwik": "none",
      "react": "none",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "none",
      "test": "all",
      "turborepo": "none",
      "types": "all",
      "vue": "none"
    },
    "rules": {
      "preset": "all",
      "nursery": {
        "noImpliedEval": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "correctness": {
        "useImportExtensions": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noVoid": "off"
      },
      "style": {
        "useDefaultSwitchClause": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/app.ts",
        "e2e/renderer-stress.spec.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/simulation/src/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Simulation must not depend on browser state.",
                  "document": "Simulation must not depend on the DOM.",
                  "navigator": "Simulation must not depend on device state.",
                  "localStorage": "Persistence belongs behind an adapter.",
                  "sessionStorage": "Persistence belongs behind an adapter.",
                  "indexedDB": "Persistence belongs behind an adapter.",
                  "fetch": "Network I/O is forbidden in deterministic simulation code.",
                  "XMLHttpRequest": "Network I/O is forbidden in deterministic simulation code.",
                  "WebSocket": "Network I/O is forbidden in deterministic simulation code.",
                  "AudioContext": "Audio belongs behind a presentation adapter.",
                  "requestAnimationFrame": "Presentation timing must not affect simulation.",
                  "setTimeout": "Ambient timing must not affect deterministic simulation.",
                  "setInterval": "Ambient timing must not affect deterministic simulation.",
                  "performance": "Ambient clock/device state must not enter simulation.",
                  "crypto": "Randomness must be injected through the simulation RNG contract."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "lit": "UI runtimes are forbidden in the simulation package.",
                  "three": "Rendering dependencies are forbidden in the simulation package."
                },
                "patterns": [
                  {
                    "group": [
                      "@lemonade/ui",
                      "@lemonade/ui/**",
                      "@lemonade/scene",
                      "@lemonade/scene/**",
                      "@lemonade/audio",
                      "@lemonade/audio/**",
                      "@tauri-apps/*",
                      "node:*"
                    ],
                    "message": "Simulation must remain a pure, platform-independent inward dependency."
                  }
                ]
              }
            }
          },
          "nursery": {
            "noJsRestrictedProperties": {
              "level": "error",
              "options": {
                "entries": [
                  {
                    "object": "Math",
                    "property": "random",
                    "message": "Inject a seedable RandomSource; ambient randomness breaks replay determinism."
                  },
                  {
                    "object": "Date",
                    "property": "now",
                    "message": "Pass time explicitly; ambient clock state is forbidden in simulation."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**/*.mjs",
        "apps/web/scripts/**/*.mjs"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/dev-*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "playwright*.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/scene-runtime.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/certify.mjs"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    }
  ]
}
