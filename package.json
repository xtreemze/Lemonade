{
  "name": "lemonade",
  "version": "0.0.0",
  "private": true,
  "description": "A modern revival of the classic Lemonade Stand business simulation",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=12.5.1 <13"
  },
  "scripts": {
    "dev": "pnpm --filter @lemonade/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "biome lint --error-on-warnings --max-diagnostics=none --reporter=summary . && pnpm lint:antipatterns && pnpm lint:mobile-contract",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "certify": "pnpm --filter @lemonade/simulation build && node scripts/certify.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "lint:antipatterns": "node scripts/lint-antipatterns.mjs",
    "lint:mobile-contract": "node scripts/lint-mobile-contract.mjs",
    "test:mobile-contract": "playwright test e2e/mobile-contract.spec.ts",
    "verify:mobile": "pnpm lint:antipatterns && pnpm lint:mobile-contract && pnpm test:mobile-contract",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtreemze/Lemonade.git"
  },
  "author": "Carlos Velasco",
  "license": "GPL-3.0-only"
}
